Subject: [PATCH] pylibfdt: build against Python 3

scripts/dtc/pylibfdt/libfdt.i_shipped still contains two unguarded Python 2
conversions, unlike the neighbouring typemaps which already test
PY_VERSION_HEX:

  - the fdt_get_property_by_offset() typemap calls PyString_FromString()
  - the fdt_next_node() typemap calls PyInt_AsLong()

On a host with Python 3.12+ these are not declared at all, so SWIG's output
fails to compile:

  libfdt_wrap.c: error: implicit declaration of function 'PyInt_AsLong';
      did you mean 'PyLong_AsLong'?
  libfdt_wrap.c: error: assignment to 'PyObject *' from 'int' makes pointer
      from integer without a cast

which aborts the whole U-Boot build in scripts/dtc/pylibfdt with
"make[2]: *** [scripts/dtc/pylibfdt/Makefile:33: rebuild] Error 1".

Guard both conversions the same way the other typemaps in this file do. Verified
with SWIG 4.5.1 and Python 3.14 on U-Boot v2026.07.

diff --git a/scripts/dtc/pylibfdt/libfdt.i_shipped b/scripts/dtc/pylibfdt/libfdt.i_shipped
index e4659489a..412f79371 100644
--- a/scripts/dtc/pylibfdt/libfdt.i_shipped
+++ b/scripts/dtc/pylibfdt/libfdt.i_shipped
@@ -1033,8 +1033,13 @@ typedef uint32_t fdt32_t;
 	PyObject *buff;
 
 	if ($1) {
+        %#if PY_VERSION_HEX >= 0x03000000
+            resultobj = PyUnicode_FromString(
+                fdt_string(fdt1, fdt32_to_cpu($1->nameoff)));
+        %#else
 		resultobj = PyString_FromString(
 			fdt_string(fdt1, fdt32_to_cpu($1->nameoff)));
+        %#endif
 		buff = PyByteArray_FromStringAndSize(
 			(const char *)($1 + 1), fdt32_to_cpu($1->len));
 		resultobj = SWIG_AppendOutput(resultobj, buff);
@@ -1070,7 +1075,11 @@ typedef uint32_t fdt32_t;
 
 /* typemaps used for fdt_next_node() */
 %typemap(in, numinputs=1) int *depth (int depth) {
+   %#if PY_VERSION_HEX >= 0x03000000
+   depth = (int) PyLong_AsLong($input);
+   %#else
    depth = (int) PyInt_AsLong($input);
+   %#endif
    $1 = &depth;
 }
 
