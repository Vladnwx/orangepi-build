# zram swap for the OrangePi Zero 2W.
#
# Swap in compressed RAM instead of on the SD card: the card is never written
# to because of swapping, and the board survives memory pressure better than
# without any swap at all. Requires the zram-tools package (installed by
# family_tweaks_s) and CONFIG_ZRAM in the kernel.
#
# zstd is the best compromise between compression ratio and CPU use for the
# small amount of memory these boards have.
ALGO=zstd

# Use up to half of RAM as the compressed swap device.
PERCENT=50

# Prefer zram over any other swap.
PRIORITY=100
